# ─── Copie este archivo como .env en la raíz (lo leen la API y docker compose) ───

# Base de datos (PostgreSQL 16 + PostGIS)
POSTGRES_USER=kalo
POSTGRES_PASSWORD=kalo_demo
POSTGRES_DB=kalo_campo
DATABASE_URL=postgres://kalo:kalo_demo@localhost:5432/kalo_campo

# Archivos (MinIO, compatible con S3)
S3_ENDPOINT=http://localhost:9000
# URL con la que el celular / navegador alcanzan MinIO (para URLs prefirmadas).
# En un celular físico use la IP de su computadora en la red local, p. ej. http://192.168.1.50:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=kalo
S3_SECRET_KEY=kalo_demo_secret
S3_BUCKET=kalo-campo
S3_REGION=us-east-1

# API
API_PORT=4000
API_HOST=0.0.0.0
# Mínimo 32 caracteres. Cámbielo fuera del demo.
JWT_SECRET=cambie-este-secreto-en-produccion-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DIAS=30
CORS_ORIGINS=http://localhost:3000

# Panel web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL_INTERNA=http://localhost:4000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# App móvil (Expo). Por defecto usa datos mock (DEMO en el teléfono, sin API).
# Para conectarla al servidor real: EXPO_PUBLIC_KALO_DATOS=api
EXPO_PUBLIC_KALO_DATOS=mock
# En un celular físico use la IP de su computadora.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Errores (opcional en el demo)
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
ZONA_HORARIA=America/Guatemala
