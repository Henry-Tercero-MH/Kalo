{
  "name": "@kalo/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "App de campo de Inversiones Kalo (Expo + React Native, offline-first)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "build:dev": "eas build --profile development --platform android",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "jest",
    "doctor": "expo-doctor",
    "marca:logo": "node scripts/usar-logo.mjs",
    "export:web": "expo export --platform web --output-dir dist-web && cp dist-web/index.html dist-web/404.html",
    "export:enlace": "node scripts/export-enlace.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/archivo": "^0.4.2",
    "@kalo/shared": "workspace:*",
    "@kalo/ui-tokens": "workspace:*",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@morrowdigital/watermelondb-expo-plugin": "^2.3.3",
    "@noble/ciphers": "^1.3.0",
    "@nozbe/watermelondb": "0.28.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "^8.29.0",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-audio": "~57.0.5",
    "expo-background-task": "~57.0.21",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.24",
    "i18next": "^26.4.2",
    "lokijs": "npm:@nozbe/lokijs@1.5.12-wmelon6",
    "lucide-react-native": "^1.52.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "zustand": "^5.0.15",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@kalo/config": "workspace:*",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "eslint": "^9.37.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~5.9.3",
    "eslint-plugin-react-hooks": "^7.0.0",
    "@types/leaflet": "^1.9.22"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/test/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@nozbe/.*|@noble/.*|@kalo/.*|lucide-react-native|@maplibre/.*))"
    ]
  }
}
