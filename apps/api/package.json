{
  "name": "@kalo/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de Kalo Campo (Fastify + Drizzle + PostGIS)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrar.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/db/seed/index.ts",
    "seed:reset": "tsx --env-file-if-exists=../../.env src/db/seed/index.ts --reset",
    "qr:trampas": "tsx --env-file-if-exists=../../.env scripts/qr-trampas.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.6",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@kalo/shared": "workspace:*",
    "@sentry/node": "^11.4.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@kalo/config": "workspace:*",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.37.0",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^3.2.4"
  }
}
